.experience {
    --surface: #111b26;
    --bar: #0d1620;
    --border: #2c3e50;
    --text: #f0f5fa;
    --muted: #aab9c8;
    --accent: #65c9ff;
    --blue: #005ca9;
    flex-grow: 1;
    color: var(--text);
    font-size: 19px;
}
.panel { background-color: var(--surface); border-color: var(--border); }
.header {
    height: 96px;
    padding: 0 28px;
    background-color: var(--bar);
    border-bottom-width: 1px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}
.brand, .mode { flex-direction: row; align-items: center; }
.mark {
    width: 45px;
    height: 45px;
    background-color: var(--blue);
    border-radius: 5px;
    justify-content: center;
    padding: 0 9px;
    margin-right: 15px;
}
.mark-line { height: 3px; margin: 2px 0; background-color: #e3f4ff; border-radius: 2px; }
.brand-title { font-size: 30px; -unity-font-style: bold; margin: 0; }
.subtitle { color: var(--muted); font-size: 17px; margin: 0; }
.product { margin-left: 30px; padding-left: 27px; border-left-width: 1px; border-color: var(--border); }
.product-title { font-size: 22px; -unity-font-style: bold; margin: 0; }
.mode { color: #cbe5f7; min-height: 36px; border-width: 1px; border-color: #2e5069; border-radius: 5px; padding: 0 11px; }
.mode-dot { width: 7px; height: 7px; border-radius: 4px; background-color: var(--accent); margin-right: 8px; }
.middle { flex-direction: row; flex-grow: 1; flex-basis: 0; }
.left { width: 266px; flex-shrink: 0; border-right-width: 1px; padding: 16px; transition-property: width; transition-duration: 160ms; }
.left.collapsed { width: 56px; padding-left: 9px; padding-right: 9px; }
.collapsed .left-title, .collapsed .left-body { display: none; }
.side-heading { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.section-title { font-size: 20px; -unity-font-style: bold; margin-left: 1px; white-space: normal; }
.icon-button { width: 35px; height: 33px; color: var(--accent); font-size: 26px; }
.left-body { flex-grow: 1; }
.component, .control, .icon-button {
    border-color: #33495f;
    border-radius: 5px;
    color: var(--text);
    background-color: #1b2a39;
    transition-property: background-color, border-color;
    transition-duration: 130ms;
}
.component:hover, .control:hover, .icon-button:hover { background-color: #263d53; border-color: #5a8aac; }
.component:active, .control:active, .icon-button:active { background-color: #0c4a76; }
.component:focus, .control:focus, .icon-button:focus { border-color: var(--accent); }
.component:disabled, .control:disabled { color: #8394a5; background-color: #151f2a; border-color: #263645; }
.component {
    height: 43px;
    margin: 0 0 5px 0;
    padding: 0 11px;
    -unity-text-align: middle-left;
    background-color: #152231;
    border-left-width: 3px;
    font-size: 17px;
}
.component.selected { background-color: #123657; border-color: #347da9; border-left-color: var(--accent); }
.component.group-open { color: var(--accent); }
.subcomponents { margin-left: 12px; }
.subcomponent { height: 34px; background-color: #111c29; }
.viewport { flex-grow: 1; flex-basis: 0; justify-content: flex-end; align-items: center; }
.viewport-help { color: #e2eaf1; background-color: #16222dd9; border-radius: 4px; margin: 0 8px 14px; padding: 6px 12px; font-size: 15px; white-space: normal; -unity-text-align: middle-center; }
.right { width: 344px; flex-shrink: 0; border-left-width: 1px; padding: 22px; }
.information-scroll { flex-grow: 1; margin-top: 17px; }
.intro, .details { padding-right: 4px; }
.details { display: none; }
.topic { font-size: 29px; -unity-font-style: bold; margin: 1px 0 10px; }
.category { color: var(--accent); font-size: 16px; margin: 0 0 16px; }
.wrap { white-space: normal; }
.body { color: #c5d1dd; font-size: 18px; margin: 0 0 14px; }
.note { color: #a1afbd; font-size: 16px; margin: 10px 0 0; }
.detail-title { color: var(--text); font-size: 17px; -unity-font-style: bold; margin: 3px 0 4px; }
.detail-action { margin: 3px 0; }
.footer { background-color: var(--bar); border-top-width: 1px; padding: 10px 22px; flex-shrink: 0; }
.toolbar, .context, .toolset { flex-direction: row; align-items: center; }
.toolbar { min-height: 50px; }
.context { min-height: 48px; flex-wrap: wrap; border-bottom-width: 1px; border-color: #243344; margin-bottom: 8px; }
.toolset { min-height: 43px; margin-right: 22px; }
.tool-label { font-size: 16px; color: var(--muted); }
.toolset .unity-slider { width: 126px; margin: 0 8px; }
.toolset .unity-toggle { color: var(--text); font-size: 16px; margin-left: 11px; }
.toolset .unity-toggle__input { min-width: 0; }
.toolset .unity-toggle__text { color: var(--text); }
.toolset .unity-base-slider__tracker { background-color: #263c50; height: 4px; border-width: 0; }
.toolset .unity-base-slider__dragger { background-color: #77c8f5; border-color: #97d5f5; border-radius: 8px; }
.value { min-width: 44px; font-size: 16px; color: var(--accent); }
.control { min-height: 39px; padding: 0 13px; margin-right: 7px; font-size: 16px; flex-shrink: 0; }
.primary { background-color: var(--blue); border-color: #297dc1; }
.active-control { background-color: #153f60; border-color: #65b9eb; }
.quiet { background-color: #131e29; }
.status-area { flex-grow: 1; flex-basis: 100px; padding: 0 6px; }
.status { color: var(--muted); font-size: 16px; }
.running-status { color: #84dfad; }
.blocked-status { color: #f2c17e; }
